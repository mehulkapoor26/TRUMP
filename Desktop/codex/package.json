{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "npm run start -w backend",
    "test:browser": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:production": "npm run build && node --import tsx scripts/judge-demo.ts --check --compiled",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "benchmark": "node --import tsx benchmark/run.ts",
    "benchmark:live": "node --import tsx benchmark/run.ts --live",
    "demo": "npm run build && node --import tsx scripts/judge-demo.ts",
    "demo:check": "node --import tsx scripts/judge-demo.ts --check",
    "demo:live": "node --import tsx scripts/published-demo.ts",
    "demo:live:browser": "node scripts/published-browser.mjs",
    "demo:python": "node --import tsx scripts/python-demo.ts",
    "demo:python:browser": "node scripts/python-browser.mjs",
    "test:live": "node --import tsx scripts/judge-demo.ts --live"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "rollup": "4.66.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "rollup": "4.66.0"
  }
}
